# Secrets : jamais versionnés
/config/*.key
/.env
/.env.*
!/.env.example

# Bundler, logs, fichiers temporaires
/.bundle
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
/tmp/pids/*
!/tmp/pids/.keep
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/.keep
/public/assets

# CSS et JS compilés
/app/assets/builds/*
!/app/assets/builds/.keep
/node_modules

# Éditeurs et système
.DS_Store
/.idea
/.vscode
/coverage
